{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mobile-campaign-navi",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": false
  }
}
